{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ondrejzeman/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ondrejzeman/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "env": {
    "GRAPHIFY_HOOK_STRICT": "1",
    "GRAPHIFY_QUERY_LOG_ENABLE": "1"
  }
}
