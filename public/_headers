/*.png
  Cache-Control: public, max-age=31536000, immutable

/Uvodni stranka/*
  Cache-Control: public, max-age=31536000, immutable

/Icons/*
  Cache-Control: public, max-age=31536000, immutable

/Logo/*
  Cache-Control: public, max-age=31536000, immutable

/Decoration/*
  Cache-Control: public, max-age=31536000, immutable

# Bezpečnostní hlavičky pro celý web.
# clickjacking, čichání typu obsahu, únik adresy v Referer a přístup
# ke kameře/mikrofonu/poloze, který web nepotřebuje.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Administrace se nesmí ukládat do mezipaměti ani indexovat.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
