# =====================================================================
#  301 PŘESMĚROVÁNÍ ZE STARÉHO PHP WEBU
#  Netlify nematchuje query parametry uvnitř cesty — musí být uvedené
#  zvlášť za mezerou. Předchozí zápis (/cz/index.php?stranka=uvod) byl
#  neplatný a všechny staré URL by po napojení domény spadly do 404.
# =====================================================================

/cz/index.php   stranka=uvod          /             301!
/cz/index.php   stranka=novinky       /aktuality    301!
/cz/index.php   stranka=ubytovani     /ubytovani    301!
/cz/index.php   stranka=sluzby        /stravovani   301!
/cz/index.php   stranka=fotogalerie   /ubytovani    301!
/cz/index.php   stranka=akce          /akce         301!
/cz/index.php   stranka=cenik         /ubytovani    301!
/cz/index.php   stranka=rezervace     /ubytovani    301!
/cz/index.php   stranka=kniha         /#recenze     301!
/cz/index.php   stranka=vylety        /okoli        301!
/cz/index.php   stranka=mapy          /kontakt      301!
/cz/index.php   stranka=kontakt       /kontakt      301!

# Poznámka: ceník i rezervace jsou sekce uvnitř /ubytovani, ne samostatné
# stránky. Recenze mají kotvu /#recenze na úvodní stránce.

# Fallback pro cokoliv dalšího ze staré struktury
/cz/index.php                         /             301!
/cz/*                                 /             301!

# Německá verze starého webu — zatím nemáme mutaci, míří na úvod
/de/index.php                         /             301!
/de/*                                 /             301!

